# Required
JWT_SECRET=your-jwt-secret-min-32-chars-long
MONGODB_URI=mongodb://localhost:27017/ipeace-consultancy

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@yourdomain.com
COMPANY_EMAIL=info@yourdomain.com

# Optional: Frontend URL for CORS (only needed if frontend is on a different origin)
FRONTEND_URL=http://localhost:3000

# Server
NODE_ENV=development
PORT=5000

# Optional: OpenAI (for chatbot)
OPENAI_API_KEY=

# Optional: Microsoft Calendar Integration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
